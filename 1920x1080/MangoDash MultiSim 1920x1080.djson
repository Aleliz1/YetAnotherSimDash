tion text(value) { return value === null || value === undefined || value === '' ? '--' : String(value); }\nfunction gear() {\n  var v = data('Gear');\n  if (v === null || v === undefined || v === '') return '--';\n  if (String(v) === '0') return 'N';\n  if (String(v) === '-1') return 'R';\n  return String(v).toUpperCase();\n}\nreturn gearHighlightColor();"
