== game() && entry.carId.toLowerCase() === id) {\n      for (var field in entry) selected[field] = entry[field];\n      break;\n    }\n  }\n  return selected;\n}\nfunction metric(value, decimals, suffix) {\n  var n = number(value);\n  return n === null ? '--' : n.toFixed(decimals || 0) + (suffix || '');\n}\nreturn '12V / ' + metric(batteryReading('batteryVoltageProperty', false), 1, ' V');"
